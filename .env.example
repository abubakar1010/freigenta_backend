# ─────────────────────────────────────────────────────────────────────────────
# Freigenta backend — environment template.
# Copy to `.env` and fill in real values. NEVER commit a filled-in .env.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development                  # development | production
PORT=8080
LOG_LEVEL=info                        # fatal|error|warn|info|debug|trace
USE_SANDBOX=true                      # "true" routes YouVerify to sandbox

# Public base URL of this API (used to build S3-fallback file links)
APP_URL=http://localhost:8080
# Public base URL of the Next.js frontend (used in password-reset emails)
FRONTEND_URL=http://localhost:3000
# Comma-separated CORS allowlist. REQUIRED in production — an empty value
# makes every cross-origin request fail once NODE_ENV=production.
ALLOWED_ORIGINS=http://localhost:3000

# ─── Database ────────────────────────────────────────────────────────────────
# Include the database name before the "?" or Mongo silently uses "test".
DATABASE_URL=mongodb+srv://<user>:<pass>@<cluster>/<dbname>?retryWrites=true&w=majority

# ─── Redis (BullMQ queues, idempotency, caching) ─────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32   (process refuses to boot without it)
JWT_SECRET=
JWT_EXPIRES_IN=15m

# At-rest encryption for sensitive fields (aes-256-cbc).
# Generate with: openssl rand -hex 32. Changing it makes existing
# ciphertext undecryptable — rotate with a re-encryption migration.
ENCRYPTION_KEY=

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Freigenta" <no-reply@freigenta.com>

# ─── AWS (S3 uploads + SNS/WhatsApp OTP) ─────────────────────────────────────
# Prefer an IAM role over static keys in deployed environments.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_SNS_TOPIC_ARN=

# ─── Bridge ──────────────────────────────────────────────────────────────────
BRIDGE_API_BASE_URL=https://api.sandbox.bridge.xyz
BRIDGE_API_URL=https://api.bridge.xyz/v1
BRIDGE_API_KEY=
BRIDGE_WEBHOOK_PUBLIC_KEY_PEM=
BRIDGE_TREASURY_WALLET_ID=
# Destination the settlement worker sends USDC to — required, worker throws without it.
BRIDGE_USDC_DEPOSIT_ADDRESS=

# ─── Esca ────────────────────────────────────────────────────────────────────
ESCA_API_BASE_URL=https://api.sandbox.esca.com
ESCA_API_URL=https://api.escafinance.com/v1
ESCA_API_KEY=
ESCA_WEBHOOK_SECRET=
# Required — settlement worker throws without it.
ESCA_NGN_ACCOUNT_ID=
ESCA_NGN_VIRTUAL_ACCOUNT_ID=
ESCA_PAYOUT_CURRENCY=USDC
ESCA_PAYOUT_PROTOCOL=SOLANA
ESCA_PAYOUT_BENEFICIARY_NAME=

# ─── YouVerify (KYC) ─────────────────────────────────────────────────────────
YOUVERIFY_API_URL=https://api.youverify.co/v2
YOUVERIFY_API_KEY=
YOUVERIFY_WEBHOOK_SECRET=

# ─── FindTEU (shipment tracking) ─────────────────────────────────────────────
FINDTEU_API_BASE_URL=https://api.findteu.com
FINDTEU_API_KEY=
# Required — an empty secret makes the verifier skip signature checks entirely.
FINDTEU_WEBHOOK_SECRET=
FINDTEU_WEBHOOK_URL=
FINDTEU_MAX_RETRIES=3
FINDTEU_REQUEST_TIMEOUT_MS=10000
